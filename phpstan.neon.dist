includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 5
    paths:
        - wp-base.php
        - src
    # WP-CLI's own stubs (php-stubs/wp-cli-stubs) require WordPress stubs 6.x or older, so skip only its class here.
    ignoreErrors:
        -
            message: '#unknown class WP_CLI\.#'
            path: src/cli.php
